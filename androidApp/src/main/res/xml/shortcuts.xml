<?xml version="1.0" encoding="utf-8"?>
<!-- Direct share (Sharing Shortcuts): shortcuts of the category below appear as targets in the system's share menu.
     The shortcuts themselves are created by ShareShortcuts, one for each of the latest conversations. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="app.anynear.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="app.anynear.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
