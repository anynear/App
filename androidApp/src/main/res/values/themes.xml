        <item name="android:windowSplashScreenBackground" tools:targetApi="s" xmlns:tools="http://schemas.android.com/tools">@color/brand_nachtblau</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s" xmlns:tools="http://schemas.android.com/tools">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
